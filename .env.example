# Copia este archivo como .env y ajusta los valores (nunca subas .env a un repositorio).
FLASK_APP=app.py
FLASK_DEBUG=0

# Clave para firmar sesiones y tokens CSRF: usa una cadena larga y aleatoria.
# Puedes generarla con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Opcional. Por defecto: SQLite en instance/simulador.db
# DATABASE_URL=sqlite:///C:/ruta/absoluta/simulador.db
